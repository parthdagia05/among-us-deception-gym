# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.

# HuggingFace token with these scopes:
#   - "Manage Jobs"          (for `hf jobs uv run` training/eval)
#   - "Write" to your repos  (to push the trained model to the Hub)
#   - "Inference Providers"  (for the live impostor LLM during gameplay)
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_yourTokenHere

# Optional: override base model / output repo
MODEL_ID=Qwen/Qwen2.5-1.5B-Instruct
OUTPUT_HF=parthdagia/among-us-multiagent-detective
